  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "EMPLOYEE",
          "MANAGER",
          "FINANCE"
        ]
      },
      "RequestStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "SUBMITTED",
          "APPROVED"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "roles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "uniqueItems": true
          }
        }
      },
      "PurchaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "createdAt",
          "requester",
          "amount",
          "status",
          "approvedBy",
          "approvedByRoles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "requester": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "currency",
              "amount"
            ],
            "properties": {
              "currency": {
                "const": "USD"
              },
              "amount": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
                "description": "Exact base-10 amount with at most 18 integral and 2 fractional digits."
              }
            }
          },
          "status": {
            "$ref": "#/components/schemas/RequestStatus"
          },
          "approvedBy": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "approvedByRoles": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Role"
                },
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ],
            "description": "Stored point-in-time snapshot."
          }
        }
      },
      "ModelProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          }
        }
      }
    }
  }
