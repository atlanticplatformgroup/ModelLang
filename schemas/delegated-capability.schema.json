{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modellang.dev/schemas/delegated-capability.schema.json",
  "title": "ModelLang delegated capability issuance result",
  "type": "object",
  "required": [
    "$schema", "delegatedCapabilityVersion", "catalogVersion", "model", "grantId",
    "operationId", "inputHash", "authority", "issuedAt", "notBefore", "expiresAt",
    "revision", "audience", "constraints", "view", "credential"
  ],
  "properties": {
    "$schema": { "const": "https://modellang.dev/schemas/delegated-capability.schema.json" },
    "delegatedCapabilityVersion": { "const": 1 },
    "catalogVersion": { "const": 6 },
    "model": {
      "type": "object",
      "required": ["id", "name", "version", "sourceHash"],
      "properties": {
        "id": { "type": "string", "pattern": "^model:" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "grantId": { "type": "string", "format": "uuid" },
    "operationId": { "type": "string", "pattern": "^action:" },
    "inputHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "authority": { "const": "delegated" },
    "issuedAt": { "type": "integer", "minimum": 0 },
    "notBefore": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "integer", "minimum": 1 },
    "revision": { "type": "string", "pattern": "^rev:1:[0-9a-f]{32}$" },
    "audience": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 2048 },
    "constraints": {
      "type": "object",
      "required": ["operation", "input", "revision", "uses", "transferable", "redelegation"],
      "properties": {
        "operation": { "const": "exact" },
        "input": { "const": "canonicalSha256" },
        "revision": { "const": "required" },
        "uses": { "const": 1 },
        "transferable": { "const": false },
        "redelegation": { "const": false }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": [
        "audience", "containsOperationInput", "containsGrantorIdentity", "containsDelegateIdentity",
        "containsCredential", "credentialDelivery", "grantsAuthority", "runtimeAuthorizationRequired"
      ],
      "properties": {
        "audience": { "const": "agent" },
        "containsOperationInput": { "const": false },
        "containsGrantorIdentity": { "const": false },
        "containsDelegateIdentity": { "const": false },
        "containsCredential": { "const": true },
        "credentialDelivery": { "const": "once" },
        "grantsAuthority": { "const": true },
        "runtimeAuthorizationRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "credential": {
      "type": "object",
      "required": ["scheme", "secret", "delivery", "value"],
      "properties": {
        "scheme": { "const": "ModelLang-Delegation" },
        "secret": { "const": true },
        "delivery": { "const": "once" },
        "value": { "type": "string", "minLength": 32, "maxLength": 4096 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
