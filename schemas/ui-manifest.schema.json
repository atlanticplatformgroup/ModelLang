{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atlanticplatformgroup/ModelLang/v0.50.0/schemas/ui-manifest.schema.json",
  "title": "ModelLang UI manifest",
  "$defs": {
    "presentation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "enum": ["text", "integer", "decimal", "boolean", "uuid", "dateTime"] } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "entityId"],
          "properties": {
            "kind": { "const": "entityReference" },
            "entityId": { "type": "string", "pattern": "^entity:" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "enumId"],
          "properties": {
            "kind": { "enum": ["enum", "enumSet"] },
            "enumId": { "type": "string", "pattern": "^enum:" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "currency", "precision", "scale"],
          "properties": {
            "kind": { "const": "money" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "precision": { "type": "integer", "minimum": 1 },
            "scale": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "inputField": {
      "type": "object",
      "required": ["parameterId", "name", "label", "required", "nullable", "presentation"],
      "properties": {
        "parameterId": { "type": "string", "pattern": "^parameter:" },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "presentation": { "$ref": "#/$defs/presentation" }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "identityBinding",
          "authorization",
          "precondition",
          "transition",
          "invariant",
          "conflict",
          "idempotency",
          "stale",
          "notFound",
          "validation"
        ]
      }
    },
    "workflowTarget": {
      "type": "object",
      "required": ["source", "parameterId", "name"],
      "properties": {
        "source": { "const": "operationInput" },
        "parameterId": { "type": "string", "pattern": "^parameter:" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "workflowState": {
      "type": "object",
      "required": ["memberId", "value", "label", "initial", "terminal"],
      "properties": {
        "memberId": { "type": "string", "pattern": "^enumMember:" },
        "value": { "type": "string" },
        "label": { "type": "string" },
        "initial": { "type": "boolean" },
        "terminal": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "workflowTransition": {
      "type": "object",
      "required": [
        "transitionId",
        "name",
        "label",
        "fromMemberId",
        "fromValue",
        "toMemberId",
        "toValue",
        "actionOperationId",
        "target",
        "fields"
      ],
      "properties": {
        "transitionId": { "type": "string", "pattern": "^transition:" },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "fromMemberId": { "type": "string", "pattern": "^enumMember:" },
        "fromValue": { "type": "string" },
        "toMemberId": { "type": "string", "pattern": "^enumMember:" },
        "toValue": { "type": "string" },
        "actionOperationId": { "type": "string", "pattern": "^action:" },
        "target": { "$ref": "#/$defs/workflowTarget" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/inputField" } }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "workflowId",
        "name",
        "label",
        "entityId",
        "stateFieldId",
        "enumId",
        "initialMemberId",
        "states",
        "transitions"
      ],
      "properties": {
        "workflowId": { "type": "string", "pattern": "^workflow:" },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "entityId": { "type": "string", "pattern": "^entity:" },
        "stateFieldId": { "type": "string", "pattern": "^field:" },
        "enumId": { "type": "string", "pattern": "^enum:" },
        "initialMemberId": { "type": "string", "pattern": "^enumMember:" },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workflowState" } },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/workflowTransition" } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "uiManifestVersion",
    "operationManifestVersion",
    "model",
    "authentication",
    "enums",
    "entities",
    "projections",
    "actions",
    "queries",
    "workflows"
  ],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/atlanticplatformgroup/ModelLang/v0.50.0/schemas/ui-manifest.schema.json" },
    "uiManifestVersion": { "const": 11 },
    "operationManifestVersion": { "const": 11 },
    "model": {
      "type": "object",
      "required": ["id", "name", "label", "version", "sourceHash"],
      "properties": {
        "id": { "type": "string", "pattern": "^model:" },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "version": { "type": "string" },
        "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "required": ["required", "callerInput"],
      "properties": {
        "required": { "const": true },
        "callerInput": { "const": false }
      },
      "additionalProperties": false
    },
    "enums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "label", "options"],
        "properties": {
          "id": { "type": "string", "pattern": "^enum:" },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "value", "label"],
              "properties": {
                "id": { "type": "string", "pattern": "^enumMember:" },
                "value": { "type": "string" },
                "label": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "label", "idFieldId", "fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^entity:" },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "idFieldId": { "type": "string", "pattern": "^field:" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["fieldId", "name", "label", "presentation", "nullable", "immutable", "snapshot"],
              "properties": {
                "fieldId": { "type": "string", "pattern": "^field:" },
                "name": { "type": "string" },
                "label": { "type": "string" },
                "presentation": { "$ref": "#/$defs/presentation" },
                "nullable": { "type": "boolean" },
                "generated": { "enum": ["uuid", "now"] },
                "immutable": { "type": "boolean" },
                "snapshot": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "label", "sourceEntityId", "fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^projection:" },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "sourceEntityId": { "type": "string", "pattern": "^entity:" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["projectionFieldId", "sourceFieldId", "name", "label", "presentation", "nullable"],
              "properties": {
                "projectionFieldId": { "type": "string", "pattern": "^projectionField:" },
                "sourceFieldId": { "type": "string", "pattern": "^field:" },
                "nestedProjectionId": { "type": "string", "pattern": "^projection:" },
                "redactable": { "const": true },
                "name": { "type": "string" },
                "label": { "type": "string" },
                "presentation": { "$ref": "#/$defs/presentation" },
                "nullable": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operationId", "name", "label", "fields", "resultEntityId", "errors", "reliability", "emittedEventIds"],
        "properties": {
          "operationId": { "type": "string", "pattern": "^action:" },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "fields": { "type": "array", "items": { "$ref": "#/$defs/inputField" } },
          "resultEntityId": { "type": "string", "pattern": "^entity:" },
          "errors": { "$ref": "#/$defs/errors" },
          "reliability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["idempotency", "scope"],
            "properties": {
              "idempotency": { "enum": ["required", "unsupported"] },
              "scope": { "const": "authenticatedPrincipal" }
            }
          },
          "emittedEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^event:" } }
        },
        "additionalProperties": false
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operationId", "name", "label", "filters", "resultProjectionId", "maxItems", "errors"],
        "properties": {
          "operationId": { "type": "string", "pattern": "^query:" },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "filters": { "type": "array", "items": { "$ref": "#/$defs/inputField" } },
          "resultProjectionId": { "type": "string", "pattern": "^projection:" },
          "maxItems": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "sorting": {
            "type": "object",
            "required": ["input", "defaultProfile", "profiles"],
            "properties": {
              "input": { "const": "sort" },
              "defaultProfile": { "const": "default" },
              "profiles": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["id", "name", "label", "fieldId", "direction"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^sortProfile:" },
                    "name": { "type": "string" },
                    "label": { "type": "string" },
                    "fieldId": { "type": "string", "pattern": "^field:" },
                    "direction": { "enum": ["asc", "desc"] }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "disclosure": {
            "type": "object",
            "required": ["redaction", "default", "fields"],
            "properties": {
              "redaction": { "const": "null" },
              "default": { "const": "redacted" },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["projectionFieldPath"],
                  "properties": {
                    "projectionFieldPath": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^projectionField:" } },
                    "ruleId": { "type": "string", "pattern": "^disclose:" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "readEvidence": {
            "type": "object",
            "required": ["mode", "scope", "storage", "requestBinding", "responseBinding", "payloadRetention", "revision"],
            "properties": {
              "mode": { "const": "transactionalAudit" },
              "scope": { "const": "successfulCommittedExecution" },
              "storage": { "const": "private" },
              "requestBinding": { "const": "canonicalSha256" },
              "responseBinding": { "const": "canonicalSha256" },
              "payloadRetention": { "const": "none" },
              "revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          },
          "pagination": {
            "type": "object",
            "required": ["kind", "cursorInput", "queryRevision"],
            "properties": {
              "kind": { "const": "cursor" },
              "cursorInput": { "const": "cursor" },
              "queryRevision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          },
          "errors": { "$ref": "#/$defs/errors" }
        },
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflow" }
    }
  },
  "additionalProperties": false
}
