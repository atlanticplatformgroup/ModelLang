{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modellang.dev/schemas/agent-tool-catalog.schema.json",
  "title": "ModelLang static agent tool catalog",
  "type": "object",
  "required": [
    "$schema", "catalogVersion", "compilerVersion", "operationManifestVersion",
    "capabilityManifestVersion", "model", "view", "adapter", "authentication", "tools"
  ],
  "properties": {
    "$schema": { "const": "https://modellang.dev/schemas/agent-tool-catalog.schema.json" },
    "catalogVersion": { "const": 1 },
    "compilerVersion": { "type": "string" },
    "operationManifestVersion": { "const": 11 },
    "capabilityManifestVersion": { "const": 10 },
    "model": {
      "type": "object",
      "required": ["id", "name", "version", "sourceHash"],
      "properties": {
        "id": { "type": "string", "pattern": "^model:" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": [
        "audience", "static", "authorizationFiltered", "containsExpressions",
        "containsCurrentState", "containsExtensions", "grantsAuthority", "runtimeAuthorizationRequired"
      ],
      "properties": {
        "audience": { "const": "agent" },
        "static": { "const": true },
        "authorizationFiltered": { "const": false },
        "containsExpressions": { "const": false },
        "containsCurrentState": { "const": false },
        "containsExtensions": { "const": false },
        "grantsAuthority": { "const": false },
        "runtimeAuthorizationRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["compatibility", "directProtocolConformance"],
      "properties": {
        "compatibility": { "const": "mcpTool" },
        "directProtocolConformance": { "const": false }
      },
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "required": ["required", "source", "callerInput"],
      "properties": {
        "required": { "const": true },
        "source": { "const": "authenticatedContext" },
        "callerInput": { "const": false }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "schemaDocument": {
      "type": "object",
      "required": ["$schema", "type"],
      "properties": {
        "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
        "type": { "enum": ["object", "array"] }
      },
      "additionalProperties": true
    },
    "endpoint": {
      "type": "object",
      "required": ["protocol", "method", "path", "authenticated", "runtimeAuthorizationRequired"],
      "properties": {
        "protocol": { "const": "http" },
        "method": { "const": "POST" },
        "path": { "type": "string", "pattern": "^/operations/(actions|queries)/[A-Za-z0-9_]+$" },
        "authenticated": { "const": true },
        "runtimeAuthorizationRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "required": [
        "protocol", "method", "path", "outcomes", "authorizationRuleId",
        "preconditionRuleIds", "revisionRuleId", "grantsAuthority"
      ],
      "properties": {
        "protocol": { "const": "http" },
        "method": { "const": "POST" },
        "path": { "type": "string", "pattern": "^/operations/actions/[A-Za-z0-9_]+/applicability$" },
        "outcomes": {
          "type": "array",
          "prefixItems": [
            { "const": "applicable" }, { "const": "denied" },
            { "const": "notApplicable" }, { "const": "stale" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "authorizationRuleId": { "type": "string", "pattern": "^authorize:" },
        "preconditionRuleIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^require:" } },
        "revisionRuleId": { "type": "string", "pattern": "^revision:" },
        "grantsAuthority": { "const": false }
      },
      "additionalProperties": false
    },
    "reliability": {
      "type": "object",
      "required": ["idempotency", "scope", "replay", "fingerprint"],
      "properties": {
        "idempotency": { "enum": ["required", "unsupported"] },
        "scope": { "const": "authenticatedPrincipal" },
        "replay": { "enum": ["storedResult", "none"] },
        "fingerprint": { "enum": ["canonicalSha256", "none"] }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": ["cardinality", "maxItems"],
      "properties": {
        "cardinality": { "enum": ["many", "page"] },
        "maxItems": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "sorting": {
      "type": "object",
      "required": ["input", "defaultProfile", "profiles"],
      "properties": {
        "input": { "const": "sort" },
        "defaultProfile": { "const": "default" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "fieldId", "direction", "identityTieBreaker"],
            "properties": {
              "id": { "type": "string", "pattern": "^sortProfile:" },
              "name": { "type": "string" },
              "fieldId": { "type": "string", "pattern": "^field:" },
              "direction": { "enum": ["asc", "desc"] },
              "identityTieBreaker": { "const": true }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "disclosure": {
      "type": "object",
      "required": ["redaction", "default", "fields"],
      "properties": {
        "redaction": { "const": "null" },
        "default": { "const": "redacted" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["projectionFieldPath"],
            "properties": {
              "projectionFieldPath": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^projectionField:" } },
              "ruleId": { "type": "string", "pattern": "^disclose:" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "readEvidence": {
      "type": "object",
      "required": ["mode", "scope", "storage", "requestBinding", "responseBinding", "payloadRetention", "revision"],
      "properties": {
        "mode": { "const": "transactionalAudit" },
        "scope": { "const": "successfulCommittedExecution" },
        "storage": { "const": "private" },
        "requestBinding": { "const": "canonicalSha256" },
        "responseBinding": { "const": "canonicalSha256" },
        "payloadRetention": { "const": "none" },
        "revision": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": ["id", "kind", "name", "description", "inputSchema", "outputSchema", "execution", "errors", "annotations"],
      "properties": {
        "id": { "type": "string", "pattern": "^(action|query):" },
        "kind": { "enum": ["action", "query"] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "inputSchema": { "$ref": "#/$defs/schemaDocument" },
        "outputSchema": { "$ref": "#/$defs/schemaDocument" },
        "execution": { "$ref": "#/$defs/endpoint" },
        "errors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["identityBinding", "authorization", "precondition", "transition", "invariant", "conflict", "idempotency", "stale", "notFound", "validation"] }
        },
        "annotations": {
          "type": "object",
          "required": ["readOnly"],
          "properties": { "readOnly": { "type": "boolean" } },
          "additionalProperties": false
        },
        "applicability": { "$ref": "#/$defs/applicability" },
        "reliability": { "$ref": "#/$defs/reliability" },
        "emittedEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^event:" } },
        "bounds": { "$ref": "#/$defs/bounds" },
        "sorting": { "$ref": "#/$defs/sorting" },
        "disclosure": { "$ref": "#/$defs/disclosure" },
        "readEvidence": { "$ref": "#/$defs/readEvidence" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "action" } }, "required": ["kind"] },
          "then": {
            "required": ["applicability", "reliability", "emittedEventIds"],
            "properties": {
              "applicability": true,
              "reliability": true,
              "emittedEventIds": true,
              "bounds": false,
              "sorting": false,
              "disclosure": false,
              "readEvidence": false
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "query" } }, "required": ["kind"] },
          "then": {
            "required": ["bounds"],
            "properties": {
              "bounds": true,
              "applicability": false,
              "reliability": false,
              "emittedEventIds": false
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
