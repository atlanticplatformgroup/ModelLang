{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modellang.dev/schemas/event-manifest.schema.json",
  "title": "ModelLang event contract",
  "type": "object",
  "required": ["$schema", "eventManifestVersion", "model", "delivery", "events"],
  "properties": {
    "$schema": { "const": "https://modellang.dev/schemas/event-manifest.schema.json" },
    "eventManifestVersion": { "const": 4 },
    "model": {
      "type": "object",
      "required": ["id", "name", "version", "sourceHash"],
      "properties": {
        "id": { "type": "string", "pattern": "^model:" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": ["semantics", "storage", "ordering", "acknowledgement", "envelopeVersion"],
      "properties": {
        "semantics": { "const": "atLeastOnce" },
        "storage": { "const": "privateTransactionalOutbox" },
        "ordering": { "const": "occurredAtThenProducerOrdinal" },
        "acknowledgement": { "const": "leaseToken" },
        "envelopeVersion": { "const": 2 }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "payloadEntityId", "source", "publicationFailurePolicy", "emittedByActionIds", "emittedByConsumerIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^event:" },
          "name": { "type": "string" },
          "payloadEntityId": { "type": "string", "pattern": "^entity:" },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "local" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind", "modelId", "modelVersion", "sourceHash"],
                "properties": {
                  "kind": { "const": "imported" },
                  "modelId": { "type": "string" },
                  "modelVersion": { "type": "string" },
                  "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                },
                "additionalProperties": false
              }
            ]
          },
          "publicationFailurePolicy": {
            "oneOf": [
              {
                "type": "object",
                "required": ["mode"],
                "properties": { "mode": { "const": "unboundedRetry" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["mode", "maxAttempts"],
                "properties": {
                  "mode": { "const": "deadLetterAfterMaxAttempts" },
                  "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 1000 }
                },
                "additionalProperties": false
              }
            ]
          },
          "emittedByActionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^action:" } },
          "emittedByConsumerIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^consumer:" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
