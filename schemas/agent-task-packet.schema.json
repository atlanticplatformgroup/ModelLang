{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atlanticplatformgroup/ModelLang/v0.50.0/schemas/agent-task-packet.schema.json",
  "title": "ModelLang authenticated bounded task packet",
  "type": "object",
  "required": [
    "$schema", "packetVersion", "catalogVersion", "resourceVersion", "model", "packetId",
    "kind", "authority", "view", "freshness", "snapshot", "closure", "actions", "observations"
  ],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/atlanticplatformgroup/ModelLang/v0.50.0/schemas/agent-task-packet.schema.json" },
    "packetVersion": { "const": 1 },
    "catalogVersion": { "const": 7 },
    "resourceVersion": { "const": 1 },
    "model": { "$ref": "#/$defs/model" },
    "packetId": { "type": "string", "format": "uuid" },
    "kind": { "const": "boundedTaskContext" },
    "authority": { "const": "none" },
    "view": { "$ref": "#/$defs/view" },
    "freshness": { "$ref": "#/$defs/packetFreshness" },
    "snapshot": {
      "type": "object",
      "required": ["atomic", "observations"],
      "properties": {
        "atomic": { "const": false },
        "observations": { "const": "independentReads" }
      },
      "additionalProperties": false
    },
    "closure": { "$ref": "#/$defs/closure" },
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/action" }
    },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "model": {
      "type": "object",
      "required": ["id", "name", "version", "sourceHash"],
      "properties": {
        "id": { "type": "string", "pattern": "^model:" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": [
        "audience", "subjectSpecific", "authorizationFiltered", "inputSpecific",
        "containsCurrentState", "containsOperationInput", "containsObservationInput",
        "containsRequestBindings", "containsAuthenticatedIdentity", "containsExpressions",
        "containsExtensions", "grantsAuthority", "runtimeAuthorizationRequired"
      ],
      "properties": {
        "audience": { "const": "agent" },
        "subjectSpecific": { "const": true },
        "authorizationFiltered": { "const": true },
        "inputSpecific": { "const": true },
        "containsCurrentState": { "const": true },
        "containsOperationInput": { "const": false },
        "containsObservationInput": { "const": false },
        "containsRequestBindings": { "const": true },
        "containsAuthenticatedIdentity": { "const": false },
        "containsExpressions": { "const": false },
        "containsExtensions": { "const": false },
        "grantsAuthority": { "const": false },
        "runtimeAuthorizationRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "packetFreshness": {
      "type": "object",
      "required": ["mode", "assembledAt", "maxAgeSeconds", "revalidate"],
      "properties": {
        "mode": { "const": "pointInTime" },
        "assembledAt": { "type": "string", "format": "date-time" },
        "maxAgeSeconds": { "const": 0 },
        "revalidate": { "const": "beforeReuse" }
      },
      "additionalProperties": false
    },
    "closure": {
      "type": "object",
      "required": ["status", "dimensions", "gaps"],
      "properties": {
        "status": { "const": "partial" },
        "dimensions": {
          "type": "object",
          "required": ["identity", "type", "applicability", "effect", "lifecycle", "observation", "version", "recovery"],
          "properties": {
            "identity": { "const": "bounded" },
            "type": { "const": "complete" },
            "applicability": { "const": "evaluated" },
            "effect": { "const": "bounded" },
            "lifecycle": { "const": "bounded" },
            "observation": { "const": "callerSelected" },
            "version": { "const": "complete" },
            "recovery": { "const": "absent" }
          },
          "additionalProperties": false
        },
        "gaps": {
          "type": "array",
          "prefixItems": [
            { "const": "declarationIdentityClosureNotPublished" },
            { "const": "taskGoalNotModeled" },
            { "const": "observationRelevanceNotProven" },
            { "const": "stateWriteEffectsNotPublished" },
            { "const": "externalEffectsNotPublished" },
            { "const": "reversibilityNotPublished" },
            { "const": "recoveryNotPublished" }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["operationId", "status", "applicable", "authority"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^action:" },
        "status": { "enum": ["applicable", "denied", "notApplicable", "stale"] },
        "applicable": { "type": "boolean" },
        "authority": { "const": "none" },
        "revision": { "type": "string", "pattern": "^rev:1:[0-9a-f]{32}$" },
        "explanation": {
          "type": "object",
          "required": ["kind", "ruleId"],
          "properties": {
            "kind": { "enum": ["authorization", "requirement", "revision"] },
            "ruleId": { "type": "string", "pattern": "^(authorize|require|revision):" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "applicable" } }, "required": ["status"] },
          "then": {
            "required": ["revision"],
            "properties": { "applicable": { "const": true }, "revision": true, "explanation": false }
          }
        },
        {
          "if": { "properties": { "status": { "const": "denied" } }, "required": ["status"] },
          "then": { "required": ["explanation"], "properties": { "applicable": { "const": false }, "revision": false, "explanation": { "type": "object", "properties": { "kind": { "const": "authorization" }, "ruleId": { "type": "string", "pattern": "^authorize:" } } } } }
        },
        {
          "if": { "properties": { "status": { "const": "notApplicable" } }, "required": ["status"] },
          "then": { "required": ["revision", "explanation"], "properties": { "applicable": { "const": false }, "revision": true, "explanation": { "type": "object", "properties": { "kind": { "const": "requirement" }, "ruleId": { "type": "string", "pattern": "^require:" } } } } }
        },
        {
          "if": { "properties": { "status": { "const": "stale" } }, "required": ["status"] },
          "then": { "required": ["revision", "explanation"], "properties": { "applicable": { "const": false }, "revision": true, "explanation": { "type": "object", "properties": { "kind": { "const": "revision" }, "ruleId": { "type": "string", "pattern": "^revision:" } } } } }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "operationId", "name", "description", "inputSchema", "outputSchema", "errors",
        "reliability", "emittedEventIds", "workflowTransitions", "applicability"
      ],
      "properties": {
        "operationId": { "type": "string", "pattern": "^action:" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "errors": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "reliability": {
          "type": "object",
          "required": ["idempotency", "scope", "replay", "fingerprint"],
          "properties": {
            "idempotency": { "enum": ["required", "unsupported"] },
            "scope": { "const": "authenticatedPrincipal" },
            "replay": { "enum": ["storedResult", "none"] },
            "fingerprint": { "enum": ["canonicalSha256", "none"] }
          },
          "additionalProperties": false
        },
        "emittedEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^event:" } },
        "workflowTransitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["workflowId", "transitionId", "fromMemberId", "toMemberId", "targetParameterId"],
            "properties": {
              "workflowId": { "type": "string", "pattern": "^workflow:" },
              "transitionId": { "type": "string", "pattern": "^transition:" },
              "fromMemberId": { "type": "string", "pattern": "^enumMember:" },
              "toMemberId": { "type": "string", "pattern": "^enumMember:" },
              "targetParameterId": { "type": "string", "pattern": "^parameter:" }
            },
            "additionalProperties": false
          }
        },
        "applicability": { "$ref": "#/$defs/decision" }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["$schema", "resourceVersion", "catalogVersion", "model", "operationId", "kind", "authority", "view", "freshness", "data"],
      "properties": {
        "$schema": { "const": "https://raw.githubusercontent.com/atlanticplatformgroup/ModelLang/v0.50.0/schemas/agent-resource.schema.json" },
        "resourceVersion": { "const": 1 },
        "catalogVersion": { "const": 7 },
        "model": { "$ref": "#/$defs/model" },
        "operationId": { "type": "string", "pattern": "^query:" },
        "kind": { "const": "queryResult" },
        "authority": { "const": "none" },
        "view": { "$ref": "#/$defs/resourceView" },
        "freshness": {
          "type": "object",
          "required": ["mode", "retrievedAt", "maxAgeSeconds", "revalidate"],
          "properties": {
            "mode": { "const": "pointInTime" },
            "retrievedAt": { "type": "string", "format": "date-time" },
            "maxAgeSeconds": { "const": 0 },
            "revalidate": { "const": "beforeReuse" }
          },
          "additionalProperties": false
        },
        "data": true
      },
      "additionalProperties": false
    },
    "resourceView": {
      "type": "object",
      "required": [
        "audience", "subjectSpecific", "authorizationFiltered", "containsCurrentState",
        "containsInput", "containsAuthenticatedIdentity", "containsExtensions",
        "grantsAuthority", "runtimeAuthorizationRequired"
      ],
      "properties": {
        "audience": { "const": "agent" },
        "subjectSpecific": { "const": true },
        "authorizationFiltered": { "const": true },
        "containsCurrentState": { "const": true },
        "containsInput": { "const": false },
        "containsAuthenticatedIdentity": { "const": false },
        "containsExtensions": { "const": false },
        "grantsAuthority": { "const": false },
        "runtimeAuthorizationRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["binding", "operationId", "resource"],
      "properties": {
        "binding": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "operationId": { "type": "string", "pattern": "^query:" },
        "resource": { "$ref": "#/$defs/resource" }
      },
      "additionalProperties": false
    }
  }
}
