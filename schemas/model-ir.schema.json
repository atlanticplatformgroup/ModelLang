{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modellang.dev/schemas/model-ir.schema.json",
  "title": "ModelLang canonical IR",
  "$defs": {
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "required": ["strategy"],
          "properties": { "strategy": { "const": "nameDerived" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["strategy", "stableId"],
          "properties": {
            "strategy": { "const": "explicitStableId" },
            "stableId": {
              "type": "string",
              "pattern": "^(ent|fld|prj|pfd|enm|emv|evt|pol|pbr|act|con|qry|inv|exc|wfl|trn)_[0-9a-f]{32}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "enumMember": {
      "type": "object",
      "required": ["id", "name", "identity", "span", "naming"],
      "properties": {
        "id": { "type": "string", "pattern": "^enumMember:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "span": { "type": "object" },
        "naming": { "type": "object" }
      }
    },
    "enum": {
      "type": "object",
      "required": ["id", "name", "identity", "members", "span", "naming"],
      "properties": {
        "id": { "type": "string", "pattern": "^enum:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "members": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/enumMember" } },
        "span": { "type": "object" },
        "naming": { "type": "object" }
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "name", "identity", "type", "optional", "annotations", "storage", "mutability", "span", "naming"],
      "properties": {
        "id": { "type": "string", "pattern": "^field:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "type": { "type": "string" },
        "optional": { "type": "boolean" },
        "annotations": { "type": "array" },
        "storage": { "enum": ["ordinary", "snapshot"] },
        "generation": {
          "type": "object",
          "required": ["strategy", "authority"],
          "properties": {
            "strategy": { "enum": ["uuid", "now"] },
            "authority": { "const": "database" }
          },
          "additionalProperties": false
        },
        "mutability": { "enum": ["mutable", "immutable"] },
        "span": { "type": "object" },
        "naming": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "generation": {} },
            "required": ["generation"]
          },
          "then": {
            "properties": {
              "optional": { "const": false },
              "storage": { "const": "ordinary" },
              "mutability": { "const": "immutable" }
            },
            "not": {
              "properties": { "default": {} },
              "required": ["default"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "generation": {
                "type": "object",
                "required": ["strategy"],
                "properties": { "strategy": { "const": "uuid" } }
              }
            },
            "required": ["generation"]
          },
          "then": { "properties": { "type": { "const": "UUID" } } }
        },
        {
          "if": {
            "properties": {
              "generation": {
                "type": "object",
                "required": ["strategy"],
                "properties": { "strategy": { "const": "now" } }
              }
            },
            "required": ["generation"]
          },
          "then": { "properties": { "type": { "const": "DateTime" } } }
        }
      ]
    },
    "invariant": {
      "type": "object",
      "required": ["id", "name", "identity"],
      "properties": {
        "id": { "type": "string", "pattern": "^invariant:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" }
      }
    },
    "exclusion": {
      "type": "object",
      "required": ["id", "name", "identity"],
      "properties": {
        "id": { "type": "string", "pattern": "^exclusion:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "name", "identity", "fields", "invariants", "temporalExclusions"],
      "properties": {
        "id": { "type": "string", "pattern": "^entity:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } },
        "temporalExclusions": { "type": "array", "items": { "$ref": "#/$defs/exclusion" } }
      }
    },
    "projectionField": {
      "type": "object",
      "required": ["id", "name", "identity", "sourceFieldId", "span"],
      "properties": {
        "id": { "type": "string", "pattern": "^projectionField:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "sourceFieldId": { "type": "string", "pattern": "^field:" },
        "span": { "type": "object" }
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "required": ["id", "name", "identity", "sourceEntityId", "fields", "span", "naming"],
      "properties": {
        "id": { "type": "string", "pattern": "^projection:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "sourceEntityId": { "type": "string", "pattern": "^entity:" },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectionField" } },
        "span": { "type": "object" },
        "naming": { "type": "object" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["id", "name", "identity", "emittedEventIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^action:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "emittedEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^event:" } },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "scope", "replay", "fingerprint"],
          "properties": {
            "mode": { "const": "required" },
            "scope": { "const": "authenticatedPrincipal" },
            "replay": { "const": "storedResult" },
            "fingerprint": { "const": "canonicalSha256" }
          }
        }
      }
    },
    "consumer": {
      "type": "object",
      "required": ["id", "name", "identity", "sourceEventId", "payloadParameter", "acceptedPayloadEntityId", "returnEntityId", "authorization", "preconditions", "failurePolicy", "effect", "emittedEventIds", "lockPlan", "delivery", "span", "naming"],
      "properties": {
        "id": { "type": "string", "pattern": "^consumer:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "sourceEventId": { "type": "string", "pattern": "^event:" },
        "payloadParameter": { "type": "object" },
        "acceptedPayloadEntityId": { "type": "string", "pattern": "^entity:" },
        "returnEntityId": { "type": "string", "pattern": "^entity:" },
        "authorization": { "type": "object" },
        "preconditions": { "type": "array" },
        "failurePolicy": {
          "oneOf": [
            {
              "type": "object",
              "required": ["mode"],
              "properties": { "mode": { "const": "unboundedRetry" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["mode", "maxAttempts", "recovery"],
              "properties": {
                "mode": { "const": "deadLetterAfterMaxAttempts" },
                "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "recovery": { "enum": ["none", "manual"] }
              },
              "additionalProperties": false
            }
          ]
        },
        "effect": { "type": "object" },
        "emittedEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^event:" } },
        "lockPlan": { "type": "array" },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "deduplication", "duplicateResult", "identity"],
          "properties": {
            "transport": { "const": "atLeastOnce" },
            "deduplication": { "const": "transactionalInbox" },
            "duplicateResult": { "const": "storedResult" },
            "identity": { "const": "consumerAndSourceEvent" }
          }
        },
        "span": { "type": "object" },
        "naming": { "type": "object" }
      }
    },
    "policyBranch": {
      "type": "object",
      "required": ["id", "name", "identity", "expression", "sourceExpression", "span"],
      "properties": {
        "id": { "type": "string", "pattern": "^policyBranch:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "expression": { "type": "object" },
        "sourceExpression": { "type": "string" },
        "span": { "type": "object" }
      }
    },
    "policy": {
      "type": "object",
      "required": ["id", "name", "identity", "parameters", "branches", "span"],
      "properties": {
        "id": { "type": "string", "pattern": "^policy:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "parameters": { "type": "array" },
        "branches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/policyBranch" } },
        "span": { "type": "object" }
      }
    },
    "query": {
      "type": "object",
      "required": ["id", "name", "identity", "sourceEntityId", "returnProjectionId"],
      "properties": {
        "id": { "type": "string", "pattern": "^query:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "sourceEntityId": { "type": "string", "pattern": "^entity:" },
        "returnProjectionId": { "type": "string", "pattern": "^projection:" }
      }
    },
    "workflowTransition": {
      "type": "object",
      "required": ["id", "name", "identity", "fromMemberId", "toMemberId", "actionId", "span"],
      "properties": {
        "id": { "type": "string", "pattern": "^transition:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "fromMemberId": { "type": "string", "pattern": "^enumMember:" },
        "toMemberId": { "type": "string", "pattern": "^enumMember:" },
        "actionId": { "type": "string", "pattern": "^action:" },
        "span": { "type": "object" }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["id", "name", "identity", "entityId", "fieldId", "enumId", "initialMemberId", "transitions", "span", "naming"],
      "properties": {
        "id": { "type": "string", "pattern": "^workflow:" },
        "name": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity" },
        "entityId": { "type": "string", "pattern": "^entity:" },
        "fieldId": { "type": "string", "pattern": "^field:" },
        "enumId": { "type": "string", "pattern": "^enum:" },
        "initialMemberId": { "type": "string", "pattern": "^enumMember:" },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/workflowTransition" } },
        "span": { "type": "object" },
        "naming": { "type": "object" }
      }
    }
  },
  "type": "object",
  "required": ["irVersion", "model", "principal", "enums", "entities", "projections", "events", "policies", "actions", "consumers", "queries", "workflows", "enforcement"],
  "properties": {
    "irVersion": { "const": 19 },
    "model": {
      "type": "object",
      "required": ["id", "name", "version", "sourceHash", "sourceFile", "naming"],
      "properties": {
        "id": { "type": "string", "pattern": "^model:" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceFile": { "type": "string" },
        "naming": {
          "type": "object",
          "required": ["sqlSchema", "internalSchema"],
          "properties": {
            "sqlSchema": { "type": "string" },
            "internalSchema": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "principal": {
      "type": "object",
      "required": ["entityId", "bindingMechanism"],
      "properties": {
        "entityId": { "type": "string", "pattern": "^entity:" },
        "bindingMechanism": { "const": "session_user" }
      },
      "additionalProperties": false
    },
    "enums": { "type": "array", "items": { "$ref": "#/$defs/enum" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "projections": { "type": "array", "items": { "$ref": "#/$defs/projection" } },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "identity", "payloadEntityId", "source", "publicationFailurePolicy", "span", "naming"],
        "properties": {
          "id": { "type": "string", "pattern": "^event:" },
          "name": { "type": "string" },
          "identity": { "$ref": "#/$defs/identity" },
          "payloadEntityId": { "type": "string", "pattern": "^entity:" },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "local" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind", "modelId", "modelVersion", "sourceHash"],
                "properties": {
                  "kind": { "const": "imported" },
                  "modelId": { "type": "string", "pattern": "^model:" },
                  "modelVersion": { "type": "string", "minLength": 1 },
                  "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                },
                "additionalProperties": false
              }
            ]
          },
          "publicationFailurePolicy": {
            "oneOf": [
              {
                "type": "object",
                "required": ["mode"],
                "properties": { "mode": { "const": "unboundedRetry" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["mode", "maxAttempts", "recovery"],
                "properties": {
                  "mode": { "const": "deadLetterAfterMaxAttempts" },
                  "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 1000 },
                  "recovery": { "enum": ["none", "manual"] }
                },
                "additionalProperties": false
              }
            ]
          },
          "span": { "type": "object" },
          "naming": { "type": "object" }
        }
      }
    },
    "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
    "queries": { "type": "array", "items": { "$ref": "#/$defs/query" } },
    "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } },
    "enforcement": { "type": "array" }
  },
  "additionalProperties": false
}
