{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modellang.dev/schemas/semantic-manifest.schema.json",
  "title": "ModelLang engineering semantic manifest",
  "$defs": {
    "span": {
      "type": "object",
      "required": ["file", "line", "column", "endLine", "endColumn"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "expression": {
      "type": "object",
      "required": ["kind", "type", "nullable"],
      "properties": {
        "kind": {
          "enum": [
            "literal", "moneyLiteral", "nullLiteral", "parameter", "entityValue",
            "fieldAccess", "enumLiteral", "policyCall", "unary", "binary", "nullComparison"
          ]
        },
        "type": { "type": "string" },
        "nullable": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "dependency": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["parameter", "field", "enumMember", "policy"] },
        "id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "name", "expression", "sourceExpression", "source", "dependencies"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "expression": { "$ref": "#/$defs/expression" },
        "sourceExpression": { "type": "string" },
        "source": { "$ref": "#/$defs/span" },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency" }
        }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^parameter:" },
        "name": { "type": "string" },
        "type": { "type": "object" }
      },
      "additionalProperties": false
    },
    "caller": {
      "type": "object",
      "required": ["parameterId", "entityId", "source"],
      "properties": {
        "parameterId": { "type": "string", "pattern": "^parameter:" },
        "entityId": { "type": "string", "pattern": "^entity:" },
        "source": { "const": "authenticatedContext" }
      },
      "additionalProperties": false
    },
    "readSet": {
      "type": "object",
      "required": ["entityIds", "fieldIds"],
      "properties": {
        "entityIds": { "type": "array", "items": { "type": "string", "pattern": "^entity:" } },
        "fieldIds": { "type": "array", "items": { "type": "string", "pattern": "^field:" } }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "identityBinding", "authorization", "precondition", "transition", "invariant",
          "conflict", "idempotency", "notFound", "validation"
        ]
      }
    }
  },
  "type": "object",
  "required": [
    "$schema", "manifestVersion", "profile", "audience", "view", "provenance",
    "model", "principal", "policies", "events", "actions", "consumers", "queries"
  ],
  "properties": {
    "$schema": { "const": "https://modellang.dev/schemas/semantic-manifest.schema.json" },
    "manifestVersion": { "const": 10 },
    "profile": { "const": "sml-transactional-core/10" },
    "audience": { "const": "engineering" },
    "view": {
      "type": "object",
      "required": ["authorizationFiltered", "currentState", "executable"],
      "properties": {
        "authorizationFiltered": { "const": false },
        "currentState": { "const": false },
        "executable": { "const": false }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["compilerVersion", "irVersion", "generator"],
      "properties": {
        "compilerVersion": { "type": "string" },
          "irVersion": { "const": 18 },
        "generator": { "const": "semantic-manifest" }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["id", "name", "version", "sourceHash", "sourceFile"],
      "properties": {
        "id": { "type": "string", "pattern": "^model:" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceFile": { "type": "string" }
      },
      "additionalProperties": false
    },
    "principal": {
      "type": "object",
      "required": ["entityId", "binding", "requestSupplied"],
      "properties": {
        "entityId": { "type": "string", "pattern": "^entity:" },
        "binding": { "const": "authenticatedContext" },
        "requestSupplied": { "const": false }
      },
      "additionalProperties": false
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source", "parameters", "evaluation", "branches", "usedBy", "coverage"],
        "properties": {
          "id": { "type": "string", "pattern": "^policy:" },
          "name": { "type": "string" },
          "source": { "$ref": "#/$defs/span" },
          "parameters": { "type": "array" },
          "evaluation": { "const": "exactlyOneBranch" },
          "branches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
          "usedBy": { "type": "array" },
          "coverage": {
            "type": "object",
            "required": ["applicability", "execution", "durableEvidence"],
            "properties": {
              "applicability": { "type": "boolean" },
              "execution": { "type": "boolean" },
              "durableEvidence": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source", "payloadEntityId", "contractSource", "publicationFailurePolicy", "emittedByActionIds", "emittedByConsumerIds", "privacy"],
        "properties": {
          "id": { "type": "string", "pattern": "^event:" },
          "name": { "type": "string" },
          "source": { "$ref": "#/$defs/span" },
          "payloadEntityId": { "type": "string", "pattern": "^entity:" },
          "contractSource": { "type": "object" },
          "publicationFailurePolicy": {
            "oneOf": [
              {
                "type": "object",
                "required": ["mode"],
                "properties": { "mode": { "const": "unboundedRetry" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["mode", "maxAttempts", "recovery"],
                "properties": {
                  "mode": { "const": "deadLetterAfterMaxAttempts" },
                  "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 1000 },
                  "recovery": { "enum": ["none", "manual"] }
                },
                "additionalProperties": false
              }
            ]
          },
          "emittedByActionIds": { "type": "array", "items": { "type": "string", "pattern": "^action:" } },
          "emittedByConsumerIds": { "type": "array", "items": { "type": "string", "pattern": "^consumer:" } },
          "privacy": {
            "type": "object",
            "required": ["outbox", "runtimeProjection"],
            "properties": { "outbox": { "const": "private" }, "runtimeProjection": { "const": false } },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "name", "source", "caller", "input", "output", "authorization",
          "preconditions", "readSet", "lockPlan", "effect", "postconditions",
          "workflowTransitionIds", "reliability", "emittedEventIds", "failureClasses"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^action:" },
          "name": { "type": "string" },
          "source": { "$ref": "#/$defs/span" },
          "caller": { "$ref": "#/$defs/caller" },
          "input": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
          "output": {
            "type": "object",
            "required": ["entityId", "cardinality"],
            "properties": {
              "entityId": { "type": "string", "pattern": "^entity:" },
              "cardinality": { "const": "one" }
            },
            "additionalProperties": false
          },
          "authorization": { "$ref": "#/$defs/rule" },
          "preconditions": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
          "readSet": { "$ref": "#/$defs/readSet" },
          "lockPlan": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "entityId", "mode", "order"],
              "properties": {
                "id": { "type": "string" },
                "entityId": { "type": "string", "pattern": "^entity:" },
                "parameterId": { "type": "string", "pattern": "^parameter:" },
                "mode": { "enum": ["share", "update"] },
                "order": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "effect": {
            "type": "object",
            "required": ["kind", "entityId", "assignments"],
            "properties": {
              "kind": { "enum": ["create", "update"] },
              "entityId": { "type": "string", "pattern": "^entity:" },
              "targetParameterId": { "type": "string", "pattern": "^parameter:" },
              "assignments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["fieldId", "expression"],
                  "properties": {
                    "fieldId": { "type": "string", "pattern": "^field:" },
                    "expression": { "$ref": "#/$defs/expression" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "postconditions": {
            "type": "object",
            "required": ["invariantIds", "temporalExclusionIds"],
            "properties": {
              "invariantIds": { "type": "array", "items": { "type": "string", "pattern": "^invariant:" } },
              "temporalExclusionIds": { "type": "array", "items": { "type": "string", "pattern": "^exclusion:" } }
            },
            "additionalProperties": false
          },
          "workflowTransitionIds": { "type": "array", "items": { "type": "string", "pattern": "^transition:" } },
          "reliability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["idempotency", "scope", "replay", "durableReceipt", "correlation"],
            "properties": {
              "idempotency": { "enum": ["required", "unsupported"] },
              "scope": { "const": "authenticatedPrincipal" },
              "replay": { "enum": ["storedResult", "none"] },
              "durableReceipt": { "type": "boolean" },
              "correlation": { "const": true }
            }
          },
          "emittedEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^event:" } },
          "failureClasses": { "$ref": "#/$defs/errors" }
        },
        "additionalProperties": false
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source", "sourceEventId", "acceptedPayloadEntityId", "output", "authorization", "preconditions", "readSet", "lockPlan", "effect", "emittedEventIds", "failurePolicy", "delivery", "privacy"],
        "properties": {
          "id": { "type": "string", "pattern": "^consumer:" },
          "name": { "type": "string" },
          "source": { "$ref": "#/$defs/span" },
          "sourceEventId": { "type": "string", "pattern": "^event:" },
          "acceptedPayloadEntityId": { "type": "string", "pattern": "^entity:" },
          "output": {
            "type": "object",
            "required": ["entityId", "cardinality"],
            "properties": { "entityId": { "type": "string", "pattern": "^entity:" }, "cardinality": { "const": "one" } },
            "additionalProperties": false
          },
          "authorization": { "$ref": "#/$defs/rule" },
          "preconditions": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
          "readSet": { "$ref": "#/$defs/readSet" },
          "lockPlan": { "type": "array" },
          "effect": { "type": "object" },
          "emittedEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^event:" } },
          "failurePolicy": {
            "oneOf": [
              {
                "type": "object",
                "required": ["mode"],
                "properties": { "mode": { "const": "unboundedRetry" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["mode", "maxAttempts", "recovery"],
                "properties": {
                  "mode": { "const": "deadLetterAfterMaxAttempts" },
                  "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 1000 },
                  "recovery": { "enum": ["none", "manual"] }
                },
                "additionalProperties": false
              }
            ]
          },
          "delivery": {
            "type": "object",
            "required": ["transport", "deduplication", "duplicateResult", "identity"],
            "properties": {
              "transport": { "const": "atLeastOnce" },
              "deduplication": { "const": "transactionalInbox" },
              "duplicateResult": { "const": "storedResult" },
              "identity": { "const": "consumerAndSourceEvent" }
            },
            "additionalProperties": false
          },
          "privacy": {
            "type": "object",
            "required": ["inbox", "evidence", "publicCapabilityProjection"],
            "properties": {
              "inbox": { "const": "private" },
              "evidence": { "const": "private" },
              "publicCapabilityProjection": { "const": false }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "name", "source", "caller", "input", "output", "authorization",
          "rowPolicy", "readSet", "orderBy", "failureClasses"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^query:" },
          "name": { "type": "string" },
          "source": { "$ref": "#/$defs/span" },
          "caller": { "$ref": "#/$defs/caller" },
          "input": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
          "output": {
            "type": "object",
            "required": ["entityId", "cardinality", "maxItems"],
            "properties": {
              "entityId": { "type": "string", "pattern": "^entity:" },
              "cardinality": { "const": "many" },
              "maxItems": { "type": "integer", "minimum": 1, "maximum": 1000 }
            },
            "additionalProperties": false
          },
          "authorization": { "$ref": "#/$defs/rule" },
          "rowPolicy": { "$ref": "#/$defs/rule" },
          "readSet": { "$ref": "#/$defs/readSet" },
          "orderBy": {
            "type": "object",
            "required": ["fieldId", "direction", "identityTieBreaker"],
            "properties": {
              "fieldId": { "type": "string", "pattern": "^field:" },
              "direction": { "enum": ["asc", "desc"] },
              "identityTieBreaker": { "const": true }
            },
            "additionalProperties": false
          },
          "failureClasses": { "$ref": "#/$defs/errors" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
