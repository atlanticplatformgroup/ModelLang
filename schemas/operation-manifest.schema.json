{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modellang.dev/schemas/operation-manifest.schema.json",
  "title": "ModelLang operation manifest",
  "$defs": {
    "valueType": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "scalar" },
            "name": { "enum": ["String", "Int", "Decimal", "Boolean", "UUID", "DateTime"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "entityId"],
          "properties": {
            "kind": { "const": "entity" },
            "entityId": { "type": "string", "pattern": "^entity:" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "enumId"],
          "properties": {
            "kind": { "enum": ["enum", "enumSet"] },
            "enumId": { "type": "string", "pattern": "^enum:" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "currency", "precision", "scale"],
          "properties": {
            "kind": { "const": "money" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "precision": { "type": "integer", "minimum": 1 },
            "scale": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "parameter": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^parameter:" },
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/valueType" }
      },
      "additionalProperties": false
    },
    "caller": {
      "type": "object",
      "required": ["parameterId", "entityId", "source", "requestSupplied"],
      "properties": {
        "parameterId": { "type": "string", "pattern": "^parameter:" },
        "entityId": { "type": "string", "pattern": "^entity:" },
        "source": { "const": "authenticatedContext" },
        "requestSupplied": { "const": false }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "identityBinding",
          "authorization",
          "precondition",
          "transition",
          "invariant",
          "conflict",
          "idempotency",
          "notFound",
          "validation"
        ]
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "name", "kind", "input", "caller", "output", "reliability", "emittedEventIds", "errors"],
      "properties": {
        "id": { "type": "string", "pattern": "^action:" },
        "name": { "type": "string" },
        "kind": { "const": "action" },
        "input": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "caller": { "$ref": "#/$defs/caller" },
        "output": {
          "type": "object",
          "required": ["entityId", "cardinality"],
          "properties": {
            "entityId": { "type": "string", "pattern": "^entity:" },
            "cardinality": { "const": "one" }
          },
          "additionalProperties": false
        },
        "reliability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["idempotency", "scope", "replay", "fingerprint"],
          "properties": {
            "idempotency": { "enum": ["required", "unsupported"] },
            "scope": { "const": "authenticatedPrincipal" },
            "replay": { "enum": ["storedResult", "none"] },
            "fingerprint": { "enum": ["canonicalSha256", "none"] }
          },
          "allOf": [
            {
              "if": { "properties": { "idempotency": { "const": "required" } }, "required": ["idempotency"] },
              "then": { "properties": { "replay": { "const": "storedResult" }, "fingerprint": { "const": "canonicalSha256" } } }
            },
            {
              "if": { "properties": { "idempotency": { "const": "unsupported" } }, "required": ["idempotency"] },
              "then": { "properties": { "replay": { "const": "none" }, "fingerprint": { "const": "none" } } }
            }
          ]
        },
        "emittedEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^event:" } },
        "errors": { "$ref": "#/$defs/errors" }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "required": ["id", "name", "kind", "input", "caller", "output", "errors"],
      "properties": {
        "id": { "type": "string", "pattern": "^query:" },
        "name": { "type": "string" },
        "kind": { "const": "query" },
        "input": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "caller": { "$ref": "#/$defs/caller" },
        "output": {
          "type": "object",
          "required": ["projectionId", "cardinality", "maxItems"],
          "properties": {
            "projectionId": { "type": "string", "pattern": "^projection:" },
            "cardinality": { "const": "many" },
            "maxItems": { "type": "integer", "minimum": 1, "maximum": 1000 }
          },
          "additionalProperties": false
        },
        "errors": { "$ref": "#/$defs/errors" }
      },
      "additionalProperties": false
    },
    "workflowTarget": {
      "type": "object",
      "required": ["source", "parameterId", "name"],
      "properties": {
        "source": { "const": "operationInput" },
        "parameterId": { "type": "string", "pattern": "^parameter:" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "workflowTransition": {
      "type": "object",
      "required": ["id", "name", "fromMemberId", "toMemberId", "actionId", "target"],
      "properties": {
        "id": { "type": "string", "pattern": "^transition:" },
        "name": { "type": "string" },
        "fromMemberId": { "type": "string", "pattern": "^enumMember:" },
        "toMemberId": { "type": "string", "pattern": "^enumMember:" },
        "actionId": { "type": "string", "pattern": "^action:" },
        "target": { "$ref": "#/$defs/workflowTarget" }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["id", "name", "entityId", "fieldId", "enumId", "initialMemberId", "transitions"],
      "properties": {
        "id": { "type": "string", "pattern": "^workflow:" },
        "name": { "type": "string" },
        "entityId": { "type": "string", "pattern": "^entity:" },
        "fieldId": { "type": "string", "pattern": "^field:" },
        "enumId": { "type": "string", "pattern": "^enum:" },
        "initialMemberId": { "type": "string", "pattern": "^enumMember:" },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/workflowTransition" } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "manifestVersion",
    "model",
    "authentication",
    "enums",
    "entities",
    "projections",
    "operations",
    "workflows"
  ],
  "properties": {
    "$schema": { "const": "https://modellang.dev/schemas/operation-manifest.schema.json" },
    "manifestVersion": { "const": 5 },
    "model": {
      "type": "object",
      "required": ["id", "name", "version", "sourceHash"],
      "properties": {
        "id": { "type": "string", "pattern": "^model:" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "required": ["required", "source", "principalEntityId", "requestSupplied"],
      "properties": {
        "required": { "const": true },
        "source": { "const": "authenticatedContext" },
        "principalEntityId": { "type": "string", "pattern": "^entity:" },
        "requestSupplied": { "const": false }
      },
      "additionalProperties": false
    },
    "enums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "members"],
        "properties": {
          "id": { "type": "string", "pattern": "^enum:" },
          "name": { "type": "string" },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "value"],
              "properties": {
                "id": { "type": "string", "pattern": "^enumMember:" },
                "name": { "type": "string" },
                "value": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "idFieldId", "fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^entity:" },
          "name": { "type": "string" },
          "idFieldId": { "type": "string", "pattern": "^field:" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "type", "nullable", "immutable", "snapshot"],
              "properties": {
                "id": { "type": "string", "pattern": "^field:" },
                "name": { "type": "string" },
                "type": { "$ref": "#/$defs/valueType" },
                "nullable": { "type": "boolean" },
                "generated": { "enum": ["uuid", "now"] },
                "immutable": { "type": "boolean" },
                "snapshot": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "sourceEntityId", "fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^projection:" },
          "name": { "type": "string" },
          "sourceEntityId": { "type": "string", "pattern": "^entity:" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "sourceFieldId", "type", "nullable"],
              "properties": {
                "id": { "type": "string", "pattern": "^projectionField:" },
                "name": { "type": "string" },
                "sourceFieldId": { "type": "string", "pattern": "^field:" },
                "type": { "$ref": "#/$defs/valueType" },
                "nullable": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/action" },
          { "$ref": "#/$defs/query" }
        ]
      }
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflow" }
    }
  },
  "additionalProperties": false
}
