{
  "name": "modellang-poc",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "bin": {
    "modelc": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "model:check": "tsx scripts/check-models.ts",
    "model:generate": "tsx scripts/generate-models.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down -v",
    "demo": "tsx scripts/demo.ts",
    "demo:reservations": "tsx scripts/demo-reservations.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
