{
  "name": "modellang",
  "version": "0.49.1",
  "description": "ModelLang reference compiler and modelc CLI for semantic application models",
  "license": "Apache-2.0",
  "author": "Nick Scipione",
  "keywords": [
    "semantic-model",
    "compiler",
    "postgresql",
    "mcp",
    "agent-tools"
  ],
  "type": "module",
  "bin": {
    "modelc": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "schemas",
    "docs/HOST_BOOTSTRAP.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "deadcode": "knip",
    "health": "npm run build && npm run lint && npm run deadcode && npm run agent:evaluate -- --check && npm run package:check && npm test",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "model:check": "tsx scripts/check-models.ts",
    "model:generate": "tsx scripts/generate-models.ts",
    "agent:evaluate": "tsx scripts/evaluate-agents.ts",
    "package:check": "tsx scripts/check-package.ts",
    "prepack": "npm run build",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down -v",
    "demo": "tsx scripts/demo.ts",
    "demo:reservations": "tsx scripts/demo-reservations.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.20.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.4",
    "eslint": "^10.8.0",
    "knip": "^6.31.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
