model Reservations version "0.24.0";

entity User @stableId("ent_82878bde58d948d4a84d85d01279e01d") {
  id: UUID @id @stableId("fld_968ff16b1c28419d9f2f7833635e5653");
  name: String @stableId("fld_c5d58534769747848252b806b96ade1d");
}

entity Resource @stableId("ent_7cb2307972954d83a6f344764faaae39") {
  id: UUID @id @stableId("fld_8a690418c88c4400b88b6efca8eaa752");
  name: String @unique @stableId("fld_41fd1b66c84441519c8ff1e4db72d145");
}

entity Reservation @stableId("ent_ba2d028e915841d1ab90adfa40d38404") {
  id: UUID @id @generated(uuid) @immutable @stableId("fld_066660fbd78d479084a9db613ee746ae");
  createdAt: DateTime @generated(now) @immutable @stableId("fld_4112857f0e4a431fb4bec42fad9884ef");
  resource: Resource @stableId("fld_8df4f409794e4c66acdbb162b6063d57");
  reservedBy: User @stableId("fld_8380b65e5a2a4c399a2743cee1a3a93a");
  startsAt: DateTime @stableId("fld_59e1f90fae57481f921c5a81dfd3a234");
  endsAt: DateTime @stableId("fld_fd818707952f4b388baea4c3132bce63");
  indexed: Boolean = false @stableId("fld_ed818707952f4b388baea4c3132bce63");

  exclusion no_overlapping_reservations @stableId("exc_d55bab6e14884cd5a7d2bacfc30458ba"):
    noOverlap(resource, startsAt, endsAt);
}

event ReservationCreated @stableId("evt_40d694c9a0a274dc79c6168e47d25968") payload Reservation;
event ReservationIndexed @stableId("evt_60d694c9a0a274dc79c6168e47d25968") payload Reservation;

action reserve @stableId("act_508ad810a19d4b79a5009871de5cd26b")(
  caller actor: User,
  resource: Resource,
  startsAt: DateTime,
  endsAt: DateTime
) -> Reservation {
  authorize true;
  require valid_interval: startsAt < endsAt;
  idempotency required;

  create Reservation {
    resource = resource;
    reservedBy = actor;
    startsAt = startsAt;
    endsAt = endsAt;
  }
  emit ReservationCreated;
}

consumer indexReservation @stableId("con_20d694c9a0a274dc79c6168e47d25968") on ReservationCreated(
  payload reservation: Reservation
) -> Reservation {
  authorize true;
  require valid_interval: reservation.startsAt < reservation.endsAt;
  retry maxAttempts 3;
  recovery manual;

  update reservation {
    indexed = true;
  }
  emit ReservationIndexed;
}

query reservationsForResource @stableId("qry_94d8a56f4c2640fab58a4c2190c35c69")(
  caller actor: User,
  resource: Resource
) from Reservation as reservation {
  authorize true;
  where reservation.resource == resource;
  orderBy reservation.startsAt asc;
  limit 100;
}
