model Procurement version "0.32.0";

enum Role @stableId("enm_025acdd67483499fbd780d0e19867e9b") {
  EMPLOYEE @stableId("emv_409f87bd5a4340d79e21d4d982175494"),
  MANAGER @stableId("emv_dd1ac9d5f2134b998a9d4fec76df5e3e"),
  FINANCE @stableId("emv_be7e2d336369444cb7bd75c42668afa6")
}

enum RequestStatus @stableId("enm_3e6bbbdf302d482080890af3aab0b40f") {
  DRAFT @stableId("emv_5528c88aa0fb42c79a9a773de2d7d675"),
  SUBMITTED @stableId("emv_9c6dc0cfd0bc4a25a89896ccb16f2fd1"),
  APPROVED @stableId("emv_8ad72d5d6c314e12864c247677e51b8d")
}

entity User @stableId("ent_66c16684f17e4b4ca79eb7d916cbf725") {
  id: UUID @id @stableId("fld_fe4c8fe8243b456eadeefb42b0bd7097");
  name: String @stableId("fld_a261560f630d4e818f8f099868078535");
  roles: Set<Role> @stableId("fld_b4b29a4d0d914ec0913e578da89e5dcb");
}

entity PurchaseRequest @stableId("ent_9bc680209327484c8e98f5f740bcc702") {
  id: UUID @id @generated(uuid) @immutable @stableId("fld_af918d24406040619a77b244a81ca5d3");
  createdAt: DateTime @generated(now) @immutable @stableId("fld_b425073719d6446b9859fe6ca97b0ffe");
  requester: User @stableId("fld_04d9bc06877d4ec38a98196239c949b5");
  amount: Money<USD> @minExclusive(0) @stableId("fld_9810e7598584487ea4a883e3c1c3f8d1");
  status: RequestStatus = RequestStatus.DRAFT @stableId("fld_afb1dee14dfa48c98961fdb40e2b0be2");
  approvedBy: User? @stableId("fld_5da56f04460f4deba9ccda4f552c2b97");
  approvedByRoles: Set<Role>? @snapshot @stableId("fld_577b4c94c9cd4b469aded37614712fba");
  approvalObserved: Boolean = false @stableId("fld_677b4c94c9cd4b469aded37614712fba");

  invariant approval_fields_match_status @stableId("inv_b70e8aa03e6d498f8b0bccf413636b19"):
    (
      status == RequestStatus.APPROVED
      and approvedBy != null
      and approvedByRoles != null
    )
    or
    (
      status != RequestStatus.APPROVED
      and approvedBy == null
      and approvedByRoles == null
    );

  invariant approval_authority_matches_amount @stableId("inv_91184dc547c24978a48362a679eeb836"):
    status != RequestStatus.APPROVED
    or
    (
      (amount <= USD 10000 and Role.MANAGER in approvedByRoles)
      or
      (amount > USD 10000 and Role.FINANCE in approvedByRoles)
    );

  invariant approver_differs_from_requester @stableId("inv_f8c6cf86f9d64874ac4159766e522cb8"):
    status != RequestStatus.APPROVED
    or approvedBy != requester;
}

event RequestOpened @stableId("evt_10d694c9a0a274dc79c6168e47d25968") payload PurchaseRequest retry maxAttempts 5 recovery manual;
event RequestSubmitted @stableId("evt_20d694c9a0a274dc79c6168e47d25968") payload PurchaseRequest retry maxAttempts 5 recovery manual;
event RequestApproved @stableId("evt_30d694c9a0a274dc79c6168e47d25968") payload PurchaseRequest retry maxAttempts 5 recovery manual;
event ApprovalObserved @stableId("evt_50d694c9a0a274dc79c6168e47d25968") payload PurchaseRequest retry maxAttempts 5 recovery manual;

// Policy branches are closed, stable authorities. Exactly one must match.
policy ApprovalAuthority @stableId("pol_a3a80ffeec774402be92cddaafd0f069")(
  actor: User,
  request: PurchaseRequest
) {
  allow manager @stableId("pbr_0d694c9a0a274dc79c6168e47d259688"):
    request.amount <= USD 10000 and Role.MANAGER in actor.roles;
  allow finance @stableId("pbr_6b38447b5bf944769d1d737c069c7420"):
    request.amount > USD 10000 and Role.FINANCE in actor.roles;
}

// Opening a request is an explicit capability of every declared business role.
// It does not depend on managers or finance users also carrying EMPLOYEE in seed data.
action openRequest @stableId("act_1e35db0451b1461e941af6283d86dca2")(
  caller actor: User,
  amount: Money<USD>
) -> PurchaseRequest {
  authorize
    Role.EMPLOYEE in actor.roles
    or Role.MANAGER in actor.roles
    or Role.FINANCE in actor.roles;
  require positive_amount: amount > USD 0;
  idempotency required;

  create PurchaseRequest {
    requester = actor;
    amount = amount;
    status = RequestStatus.DRAFT;
    approvedBy = null;
    approvedByRoles = null;
  }
  emit RequestOpened;
}

action submitRequest @stableId("act_ed2374e822704c51a2925338253d05d2")(
  caller actor: User,
  request: PurchaseRequest
) -> PurchaseRequest {
  authorize actor == request.requester;
  require is_draft: request.status == RequestStatus.DRAFT;

  update request {
    status = RequestStatus.SUBMITTED;
  }
  emit RequestSubmitted;
}

action approveRequest @stableId("act_d39dbb883b5f4019b9027b85add3de47")(
  caller actor: User,
  request: PurchaseRequest
) -> PurchaseRequest {
  authorize
    actor != request.requester
    and ApprovalAuthority(actor, request);

  require is_submitted: request.status == RequestStatus.SUBMITTED;

  update request {
    status = RequestStatus.APPROVED;
    approvedBy = actor;
    approvedByRoles = actor.roles;
  }
  emit RequestApproved;
}

consumer observeRequestApproval @stableId("con_10d694c9a0a274dc79c6168e47d25968") on RequestApproved(
  payload request: PurchaseRequest
) -> PurchaseRequest {
  authorize true;
  require is_approved: request.status == RequestStatus.APPROVED;
  retry maxAttempts 3;
  recovery manual;

  update request {
    approvalObserved = true;
  }
  emit ApprovalObserved;
}

workflow PurchaseRequestLifecycle @stableId("wfl_96a1115ba9bf42f2a206374822eeaa87") for PurchaseRequest.status {
  initial RequestStatus.DRAFT;
  transition submit @stableId("trn_7787ccd311944f109b69e35967bcbe2c"):
    RequestStatus.DRAFT -> RequestStatus.SUBMITTED by submitRequest;
  transition approve @stableId("trn_efd18c8576154ba8b138c97b551afae3"):
    RequestStatus.SUBMITTED -> RequestStatus.APPROVED by approveRequest;
}

projection UserSummary @stableId("prj_76d694c9a0a274dc79c6168e47d25968") from User {
  id @stableId("pfd_77d694c9a0a274dc79c6168e47d25968");
  name @stableId("pfd_78d694c9a0a274dc79c6168e47d25968");
}

projection RequestSummary @stableId("prj_70d694c9a0a274dc79c6168e47d25968") from PurchaseRequest {
  id @stableId("pfd_71d694c9a0a274dc79c6168e47d25968");
  createdAt @stableId("pfd_72d694c9a0a274dc79c6168e47d25968");
  amount @stableId("pfd_73d694c9a0a274dc79c6168e47d25968");
  status @stableId("pfd_74d694c9a0a274dc79c6168e47d25968");
  approvedBy: UserSummary @stableId("pfd_75d694c9a0a274dc79c6168e47d25968");
}

query myRequests @stableId("qry_4406b045404a48449282db804f6167a8")(
  caller actor: User
) returns RequestSummary from PurchaseRequest as request {
  authorize true;
  where request.requester == actor;
  orderBy request.id asc;
  limit 100;
}
