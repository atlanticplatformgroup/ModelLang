program             = modelDeclaration, { declaration } ;
consumerDeclaration = "consumer", identifier, [ stableId ], "on", identifier,
                      "(", "payload", identifier, ":", type, ")", "->", type, "{",
                      "authorize", expression, ";", { requirement }, [ retryPolicy ], effect,
                      { "emit", identifier, ";" }, "}" ;
retryPolicy         = "retry", "maxAttempts", integer, ";" ;

(* Productions not replaced above are inherited from ModelLang 0.22. *)
