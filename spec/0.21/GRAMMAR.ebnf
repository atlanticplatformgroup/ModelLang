program          = modelDeclaration, { declaration } ;
declaration      = enumDeclaration | entityDeclaration | eventDeclaration | policyDeclaration | actionDeclaration | consumerDeclaration | queryDeclaration | workflowDeclaration ;
eventDeclaration = "event", identifier, [ stableId ], "payload", identifier,
                   [ "from", string, "version", string, "sourceHash", string ], ";" ;
consumerDeclaration = "consumer", identifier, [ stableId ], "on", identifier,
                      "(", "payload", identifier, ":", type, ")", "->", type, "{",
                      "authorize", expression, ";", { requirement }, effect, "}" ;

(* Productions not replaced above are inherited from ModelLang 0.20. *)
